---
import AppLayout from "../layouts/AppLayout.astro";
import { marked } from "marked";
import pages from "../generated/pages.json";
const page = pages.find((p) => p.sourcePath === "docs/architecture/GOVERNANCE-ARCHITECTURE.md");
const html = marked.parse(page?.body ?? "Architecture unavailable.");
---
<AppLayout title="Architecture" section="architecture"><div class="page-head"><span class="eyebrow">Foundational document</span><h1>Governance architecture</h1><p>The complete configuration for the workspace federation, repository boundaries, authority model, information zones, and operating flow.</p></div><article class="document" set:html={html}/></AppLayout>


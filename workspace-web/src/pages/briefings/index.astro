---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
import pages from '../../generated/pages.json';
import { hrefFor } from '../../lib/content-routes';
const briefings = pages.filter(page => page.section === 'briefings').sort((a, b) => (b.updated ?? '').localeCompare(a.updated ?? '') || a.title.localeCompare(b.title, 'nl'));
---
<AppLayout title="Briefings" section="briefings" description="Onderzoek, adviezen en demoplannen voor het gemeenteteam.">
  <div lang="nl-BE">
    <div class="page-head"><span class="eyebrow">Onderzoek · advies · demonstratie</span><h1>Briefings</h1><p>De belangrijkste bevindingen en voorstellen, op één plek. Lees wat we weten, welke keuzes voorliggen en wat de volgende stap kan zijn.</p></div>
    <div class="briefing-bar"><span>{briefings.length} briefings</span><span>Nieuwste actualisering eerst</span></div>
    <div class="briefing-grid">
      {briefings.map(briefing => <a class="briefing-card" href={hrefFor(briefing.sourcePath)}>
        <div class="briefing-meta"><span><Icon name="document"/>{briefing.topic}</span><time datetime={briefing.updated}>{briefing.updated}</time></div>
        <h2>{briefing.title}</h2><p>{briefing.summary}</p>
        <div class="briefing-footer"><span>{briefing.reviewer === "nog-niet-toegewezen" ? "Menselijke review open" : briefing.status}</span><strong>Lees briefing →</strong></div>
      </a>)}
    </div>
    <p class="briefing-note">Onafhankelijke analyses en voorstellen. De oorspronkelijke brondata, reviewstatus en publicatiegrenzen staan bij elke briefing. Dit zijn geen gemeentelijke besluiten.</p>
  </div>
</AppLayout>
<style>
  .briefing-bar{display:flex;justify-content:space-between;gap:16px;margin:28px 0 18px;color:var(--muted);font-size:12px}
  .briefing-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .briefing-card{display:flex;flex-direction:column;border:1px solid var(--line);padding:26px;transition:background .15s}
  .briefing-card:hover{background:#f7f7f4}.briefing-card:focus-visible{outline:3px solid #111;outline-offset:3px}
  .briefing-meta,.briefing-meta span,.briefing-footer{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .briefing-meta{font-size:11px;color:var(--muted)}.briefing-meta time{white-space:nowrap}
  .briefing-card h2{font-size:25px;line-height:1.18;letter-spacing:-.04em;margin:30px 0 12px}
  .briefing-card p{font-size:14px;line-height:1.6;color:var(--muted);margin:0 0 30px}
  .briefing-footer{margin-top:auto;border-top:1px solid var(--line);padding-top:18px;font-size:11px}.briefing-footer span{color:var(--muted)}
  .briefing-note{font-size:12px;line-height:1.6;color:var(--muted);max-width:700px;margin-top:26px}
  @media(max-width:1100px){.briefing-grid{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.briefing-card{transition:none}}
</style>

---
import AppLayout from "../../layouts/AppLayout.astro";
import Icon from "../../components/Icon.astro";
import pages from "../../generated/pages.json";

const projects = pages
  .filter((page) => page.section === "projects" && page.projectId)
  .sort((a, b) => (a.sequence ?? 99) - (b.sequence ?? 99));
const projectHref = (sourcePath: string) => `/projects/${sourcePath.split("/").pop()?.replace(/\.md$/, "")}/`;
---
<AppLayout title="Projecten" section="projects" description="Actuele uitvoering en volgende stappen voor drie projecten rond digitale dienstverlening.">
  <div class="page-head project-page-head">
    <span class="eyebrow">Digitale dienstverlening · stand 7 september 2026</span>
    <h1>Drie projecten.<br/>Eén fundament.</h1>
    <p>De website is online als beveiligd testprototype. Het meldpunt toont nu een volledige fictieve meldingsketen; de aanvraagflow voor evenementen is de volgende bouwstap.</p>
  </div>
  <div class="notice"><Icon name="shield"/><span><strong>Onafhankelijk prototype.</strong> De website mag als beveiligde test worden gedeeld. Geen van de projecten is een officiële gemeentelijke productiedienst of verbonden met echte burgerdossiers.</span></div>
  <div class="project-deliverables"><div><span class="eyebrow">Voorstel voor de demonstratie</span><h2>Van een duidelijke website naar een complete dienstverlening</h2><p>Probeer de fictieve meldingsketen van inwoner tot medewerker en terugkoppeling. Daarna volgen een hervatbare evenementenvoorbereiding en redactionele review.</p></div><div class="project-deliverable-links"><a class="workspace-action" href="/briefings/demo-gemeenteteam/">Bekijk het demoplan →</a><a href="https://website.nazarethdepinte.net/">Open de bestaande website ↗</a></div></div>
  <div class="portfolio-flow" aria-label="Projectoverzicht">
    {projects.map((project, index) => <a href={projectHref(project.sourcePath)}><span>{String(index + 1).padStart(2, "0")}</span><strong>{project.title.replace(/^P\d+\s+—\s+/, '')}</strong><small>{project.stage}</small></a>)}
  </div>
  <section>
    <div class="section-head"><div><span class="eyebrow">Portfolio</span><h2>Waar staan we nu?</h2></div><span class="portfolio-count">{projects.length} projecten</span></div>
    <div class="project-grid">
      {projects.map((project) => <a class="project-card" href={projectHref(project.sourcePath)}>
        <div class="project-kicker"><span>Project</span><span class="status-pill">{project.stage}</span></div>
        <h2>{project.title.replace(/^P\d+\s+—\s+/, "")}</h2>
        <p>{project.summary}</p>
        <div class="project-next"><small>Volgende oplevering</small><strong>{project.firstRelease}</strong></div>
        <div class="project-meta"><span>{project.timebox}</span><span>{project.updated}</span></div>
        <span class="project-link">Bekijk status en volgende stappen →</span>
      </a>)}
    </div>
  </section>
  <section><div class="section-head"><div><span class="eyebrow">Gedeelde grens</span><h2>Wat de projecten samen gebruiken</h2></div></div><div class="cards"><article><Icon name="globe"/><h3>Publieke basis</h3><p>Dienstencatalogus, ontwerpsysteem, bronnen, toegankelijkheid en performance komen uit P1.</p></article><article><Icon name="lock"/><h3>Beschermde uitvoering</h3><p>Echte aanvragen en meldingen blijven in bevoegde operationele systemen buiten deze publieke repository.</p></article><article><Icon name="scale"/><h3>Menselijke bevoegdheid</h3><p>Een bevoegde mens publiceert, dient in, beoordeelt, prioriteert en beslist.</p></article></div></section>
</AppLayout>

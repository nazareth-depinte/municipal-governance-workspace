---
import AppLayout from "../layouts/AppLayout.astro";
import pages from "../generated/pages.json";
---
<AppLayout title="Public knowledge" section="public"><div class="page-head"><span class="eyebrow">Approved public projection</span><h1>Public knowledge</h1><p>Only allowlisted material enters this interface. Protected and official-use repositories have separate indexes.</p></div><div class="knowledge-table"><div class="table-row header"><span>Document</span><span>Section</span><span>Status</span><span>Source</span></div>{pages.map((page)=><a class="table-row" href={page.sourcePath === "docs/architecture/GOVERNANCE-ARCHITECTURE.md" ? "/architecture/" : page.sourcePath === "AUTHORITY.md" ? "/authority/" : "#"}><span><strong>{page.title}</strong><small>{page.description}</small></span><span>{page.section}</span><span>{page.status}</span><code>{page.sourcePath}</code></a>)}</div></AppLayout>

